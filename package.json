{
  "scripts": {
    "postinstall": "go run main.go",
    "reset": "rm -f cache.json",
    "build": "astro build",
    "dev": "astro dev --host",
    "preview": "astro preview",
    "format": "prettier --write .",
    "lint": "eslint src && stylelint \"src/**/*.{css,astro}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,json,md,ts}": [
      "eslint",
      "prettier --write"
    ],
    "*.css": [
      "stylelint",
      "prettier --write"
    ],
    "*.astro": [
      "eslint",
      "stylelint",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "astro": "7.1.3",
    "astro-eslint-parser": "3.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "17.14.1",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3"
  }
}
