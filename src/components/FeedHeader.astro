---
import FeedActions from "./FeedActions.astro"
import type { Feed } from "../utils/feeds"

interface Props {
  feed: Feed
  linked?: boolean
  titleClass?: string
  href?: string
  profileFeed?: boolean
}

const {
  feed,
  linked = true,
  titleClass = "",
  href = `/sites/${feed.slug}/`,
  profileFeed,
} = Astro.props
---

{
  linked ? (
    <a
      class:list={["flex-1 text-ink", titleClass]}
      href={href}
      target={href.startsWith("/") ? undefined : "_blank"}
    >
      {feed.title}
    </a>
  ) : (
    <span class:list={["flex-1", titleClass]}>{feed.title}</span>
  )
}
<FeedActions feed={feed} profileFeed={profileFeed} />
