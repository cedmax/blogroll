---
import type { Profile } from "../utils/profiles"

interface Props {
  profile: Profile
  tab: "recenti" | "lista"
}

const { profile, tab } = Astro.props
const base = `/u/${profile.slug}/`
---

<div class="mt-12 mb-10">
  <div class="bg-card border border-border rounded py-4 px-5 mb-4">
    <div class="flex flex-wrap justify-between items-center gap-x-4 gap-y-2">
      <h1 class="min-w-0 wrap-anywhere text-xl font-black text-ink-muted">
        /u/<span class="text-ink">{profile.slug}</span>
      </h1>
      <nav class="flex justify-center text-sm gap-5">
        {
          tab === "recenti" ? (
            <span class="text-ink font-semibold">post recenti</span>
          ) : (
            <a class="text-ink-muted hover:text-accent" href={base}>
              post recenti
            </a>
          )
        }
        {
          tab === "lista" ? (
            <span class="text-ink font-semibold">la lista</span>
          ) : (
            <a class="text-ink-muted hover:text-accent" href={`${base}lista/`}>
              la lista
            </a>
          )
        }
        <a
          class="text-ink-muted hover:text-accent"
          target="_blank"
          href={`/u/${profile.slug}.opml`}>OPML</a
        >
      </nav>
    </div>
    <div class="wrap-anywhere text-sm text-ink-muted mt-1">
      tutti i siti seguiti da {profile.displayName}
    </div>
  </div>
</div>
