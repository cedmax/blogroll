---
import Base from "../../../layouts/Base.astro"
import EntryRow from "../../../components/EntryRow.astro"
import FeedHeader from "../../../components/FeedHeader.astro"
import MetaLine from "../../../components/MetaLine.astro"
import { feedLinks, profilesFetchedAt } from "../../../utils/profiles"

export async function getStaticPaths() {
  const { sites } = await feedLinks()
  return [...sites].map(([slug, feed]) => ({ params: { slug }, props: { feed } }))
}

const { feed } = Astro.props
---

<Base
  title={`${feed.title} — blogroll.it`}
  description={feed.description}
  canonical={`https://blogroll.it/u/sites/${feed.slug}/`}
  activeNav=""
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <MetaLine slot="meta-line">aggiornato il {profilesFetchedAt}</MetaLine>

  <div class="bg-card border border-border rounded py-4 px-5 mb-4">
    <div class="text-lg font-bold mb-1 flex items-baseline gap-2 flex-wrap">
      <FeedHeader feed={feed} linked={false} profileFeed titleClass="text-lg font-bold" />
    </div>
    {
      feed.description && (
        <div class="text-sm text-ink-muted leading-relaxed">{feed.description}</div>
      )
    }
  </div>

  {
    feed.entries.length > 0 && (
      <div class="bg-card border border-border rounded overflow-hidden">
        {feed.entries.map((entry) => (
          <EntryRow {...entry} />
        ))}
      </div>
    )
  }
</Base>
